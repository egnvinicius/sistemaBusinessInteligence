# Copie para .env e ajuste para o seu ambiente
NODE_ENV=development
PORT=3333

DATABASE_URL=postgres://bi:bi@localhost:5432/bi

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave

ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=7

# Chave que criptografa as senhas das conexões (guarde junto com o backup)
CHAVE_CRIPTOGRAFIA=troque-esta-chave

# Desenvolvedor criado no primeiro start (troca de senha obrigatória no 1º acesso)
ADMIN_LOGIN=admin
ADMIN_SENHA=Admin@123
ADMIN_EMAIL=

# Banco das cargas. Em branco: banco "bi_dados" no mesmo servidor do DATABASE_URL (criado sozinho)
BI_DADOS_URL=

# Fuso das agendas e liga/desliga o agendador
FUSO_AGENDA=America/Sao_Paulo
AGENDADOR_ATIVO=true

# Pasta onde ficam logo e imagem de fundo
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

MAX_TENTATIVAS_LOGIN=5
BLOQUEIO_MINUTOS=15

# true quando a ferramenta estiver atrás de HTTPS
COOKIE_SECURE=false

# Só necessário se front e API ficarem em domínios diferentes (ex.: http://localhost:5173)
CORS_ORIGIN=
