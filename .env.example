# Copie para .env (mesma pasta do docker-compose.yml) e ajuste os valores.

# Porta em que a ferramenta fica acessível: http://SERVIDOR:8080
WEB_PORT=8080

# Banco da ferramenta (PostgreSQL)
POSTGRES_DB=bi
POSTGRES_USER=bi
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura das sessões. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-esta-chave-longa-e-aleatoria

# Chave que criptografa as senhas das conexões (SQL Server). Gere uma com o mesmo comando acima.
# IMPORTANTE: guarde-a junto com o backup. Se ela mudar, as senhas das conexões precisam ser informadas de novo.
CHAVE_CRIPTOGRAFIA=troque-esta-chave-longa-e-aleatoria-diferente-da-anterior

# Desenvolvedor criado no primeiro start (a troca de senha é obrigatória no 1º acesso)
ADMIN_LOGIN=admin
ADMIN_SENHA=Admin@123
ADMIN_EMAIL=

# Fuso horário usado para interpretar as agendas das tarefas
FUSO_AGENDA=America/Sao_Paulo

# Mude para true quando a ferramenta estiver publicada atrás de HTTPS
COOKIE_SECURE=false

# ---------- Login com Google (opcional) ----------
# ID do cliente OAuth "Aplicativo da Web" criado no Google Cloud Console (APIs e serviços › Credenciais).
# Em "Origens JavaScript autorizadas", inclua o endereço da ferramenta (ex.: https://bi.ghlogistica.com.br).
# Vazio = botão do Google não aparece. Só entra quem já tem cadastro com o mesmo e-mail.
GOOGLE_CLIENT_ID=
# Opcional: aceitar só contas deste domínio do Google Workspace
GOOGLE_DOMINIO=

# ---------- IA das análises (Claude, da Anthropic) ----------
# Chave criada em console.anthropic.com. A IA recebe só o pedido e os nomes/tipos das colunas, nunca os dados.
# Vazio = análises só manuais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Pedidos à IA por pessoa por dia (controle de custo)
IA_LIMITE_DIARIO=50
